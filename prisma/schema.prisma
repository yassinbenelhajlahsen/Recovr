generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String   @id @db.Uuid
  email                String   @unique
  name                 String?
  height_inches        Int?
  weight_lbs           Int?
  fitness_goals        String[]
  gender               String?
  onboarding_completed Boolean  @default(false)
  created_at           DateTime @default(now())

  workouts    Workout[]
  exercises   Exercise[]
  suggestions Suggestion[]
}

model Exercise {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  muscle_groups String[]
  equipment     String?
  user_id       String?  @db.Uuid

  user              User?             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  workout_exercises WorkoutExercise[]

  @@index([user_id])
}

model Workout {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String   @db.Uuid
  date             DateTime @default(now())
  notes            String?
  duration_minutes Int?
  body_weight      Float?
  is_draft         Boolean @default(false)
  source           String  @default("manual")

  user              User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  workout_exercises WorkoutExercise[]
  suggestion        Suggestion?

  @@index([user_id, is_draft, date(sort: Desc)])
  @@index([date])
}

model WorkoutExercise {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workout_id  String @db.Uuid
  exercise_id String @db.Uuid
  order       Int

  workout  Workout  @relation(fields: [workout_id], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exercise_id], references: [id], onDelete: Cascade)
  sets     Set[]

  @@index([workout_id])
  @@index([exercise_id])
}

model Set {
  id                  String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workout_exercise_id String @db.Uuid
  reps                Int
  weight              Float
  set_number          Int

  workout_exercise WorkoutExercise @relation(fields: [workout_exercise_id], references: [id], onDelete: Cascade)

  @@index([workout_exercise_id])
}

model Suggestion {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  title      String
  rationale  String
  exercises  Json
  presets    String[] @default([])
  draft_id   String?  @unique @db.Uuid
  created_at DateTime @default(now())

  user  User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  draft Workout? @relation(fields: [draft_id], references: [id], onDelete: SetNull)

  @@index([user_id, created_at(sort: Desc)])
}

model KeepAlive {
  id        Int      @id @default(1)
  last_ping DateTime @default(now())
}
